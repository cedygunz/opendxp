{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% if collector.count > 0 %}
        {% set icon %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                <path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.37.86.58 1.41.58s1.05-.21 1.41-.59l7-7c.37-.36.59-.86.59-1.41s-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/>
            </svg>
            <span class="sf-toolbar-value">{{ collector.count }}</span>
        {% endset %}
        {% set text %}
            <div class="sf-toolbar-info-piece">
                <b>Cache Tags</b>
                <span class="sf-toolbar-status">{{ collector.count }}</span>
            </div>
            {% for type, tags in collector.types %}
                <div class="sf-toolbar-info-piece">
                    <b>{{ type }}</b>
                    <span>{{ tags|length }}</span>
                </div>
            {% endfor %}
            {% if collector.externalTags|length > 0 %}
                <div class="sf-toolbar-info-piece">
                    <b>External</b>
                    <span>{{ collector.externalTags|length }}</span>
                </div>
            {% endif %}
        {% endset %}
        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: profiler_url }) }}
    {% endif %}
{% endblock %}

{% block menu %}
    <span class="label {{ collector.count == 0 ? 'disabled' }}">
        <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.37.86.58 1.41.58s1.05-.21 1.41-.59l7-7c.37-.36.59-.86.59-1.41s-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/>
            </svg>
        </span>
        <strong>HTTP Cache Tags</strong>
        {% if collector.count > 0 %}
            <span class="count"><span>{{ collector.count }}</span></span>
        {% endif %}
    </span>
{% endblock %}

{% block panel %}
    <h2>HTTP Cache Tags</h2>

    {% if collector.count == 0 %}
        <div class="empty">
            <p>No cache tags were collected for this request.</p>
        </div>
    {% else %}
        <div class="metrics">
            <div class="metric">
                <span class="value">{{ collector.count }}</span>
                <span class="label">Total Tags</span>
            </div>
            <div class="metric">
                <span class="value">{{ collector.types|length }}</span>
                <span class="label">Tag Types</span>
            </div>
            {% if collector.externalTags|length > 0 %}
                <div class="metric">
                    <span class="value">{{ collector.externalTags|length }}</span>
                    <span class="label">External</span>
                </div>
            {% endif %}
        </div>

        {% for type, tags in collector.types %}
            <h3>{{ type }} <small>({{ tags|length }})</small></h3>
            <table>
                <thead>
                    <tr><th>Tag</th></tr>
                </thead>
                <tbody>
                    {% for tag in tags %}
                        <tr><td><code>{{ tag }}</code></td></tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endfor %}

        {% if collector.externalTags|length > 0 %}
            <h3>External <small>({{ collector.externalTags|length }})</small></h3>
            <p style="color: #999; font-size: 0.85em; margin: 0 0 0.5em">
                Added via FOSHttpCacheBundle directly (e.g. <code>fos_httpcache_tag()</code>, <code>#[Tag]</code>).
            </p>
            <table>
                <thead>
                    <tr><th>Tag</th></tr>
                </thead>
                <tbody>
                    {% for tag in collector.externalTags %}
                        <tr><td><code>{{ tag }}</code></td></tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    {% endif %}
{% endblock %}